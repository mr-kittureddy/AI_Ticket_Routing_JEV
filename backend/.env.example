# Copy to backend/.env for local development (never commit .env).
# The backend reads this file from the directory you start it in, so run uvicorn and pytest from backend/.

ENVIRONMENT=development
DEBUG=true

# Leave the keys blank (or unchanged) for deterministic simulator mode.
# A key is treated as real only if it starts with "sk-or" (OpenRouter) or "AIza" (Gemini).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.14
GEMINI_MODEL=gemini-3.8-flash
JEV_LATENCY_THRESHOLD_MS=500

# Defaults: a local SQLite file and a local ChromaDB folder.
DATABASE_URL=sqlite:///./support_tickets.db
CHROMA_PERSIST_DIR=./chroma_store

# A JSON list, because the setting is a list of strings.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

ENFORCE_RBAC_ON_PROCESS_TICKET=false

# Estimated-savings baselines credited per ticket that bypasses Gemini (assumptions, not measurements).
BASELINE_GEMINI_LATENCY_MS=1500
BASELINE_GEMINI_COST_USD=0.0004
