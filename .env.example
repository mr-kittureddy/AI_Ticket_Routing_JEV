# Copy to .env (never commit .env). Every variable is optional; the defaults run the whole stack locally.

# --- PostgreSQL (used by docker compose) ---------------------------------------------------------------------
# The password is embedded in DATABASE_URL, so use letters and digits only (no @ : / ? # % characters).
POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ticket_routing

# --- Live engines (optional) ----------------------------------------------------------------------------------
# Leave blank for deterministic simulator mode: JEV uses a local rule engine and Gemini uses a template drafter.
# The dashboard labels every result as Live or Simulated. A key is treated as real only if it starts with
# "sk-or" (OpenRouter) or "AIza" (Gemini).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.14
GEMINI_MODEL=gemini-3.8-flash
JEV_LATENCY_THRESHOLD_MS=500

# --- Access control -------------------------------------------------------------------------------------------
# false (default): POST /api/process-ticket is open, as in the PRD's no-auth prototype.
# true: it requires a known user holding the tickets:process permission (agent or admin) via X-User-Email.
ENFORCE_RBAC_ON_PROCESS_TICKET=false

# --- Frontend build -------------------------------------------------------------------------------------------
# The URL the BROWSER uses to reach the backend. It is baked into the frontend at build time, so rebuild the
# frontend image after changing it, and keep the backend's CORS_ORIGINS in docker-compose.yml in sync.
VITE_API_BASE_URL=http://localhost:8000
